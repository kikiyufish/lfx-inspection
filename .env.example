# Vercel 部署环境变量配置
# 在 Vercel 项目设置中添加以下环境变量

# Supabase 数据库配置
COZE_SUPABASE_URL=your_supabase_url
COZE_SUPABASE_ANON_KEY=your_supabase_anon_key
COZE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# S3 对象存储配置（照片上传）
COZE_BUCKET_ENDPOINT_URL=your_s3_endpoint_url
COZE_BUCKET_NAME=your_bucket_name
COZE_BUCKET_ACCESS_KEY=your_access_key
COZE_BUCKET_SECRET_KEY=your_secret_key

# 项目环境
COZE_PROJECT_ENV=PROD
